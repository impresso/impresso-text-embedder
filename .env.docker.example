# Docker build arguments for EPFL RCP / Run:AI
# Copy this file to .env.docker and fill in your values.
# Find your UID/GID by running: ssh <gaspar>@haas001.rcp.epfl.ch && id

LDAP_UID=
LDAP_GID=
LDAP_USERNAME=
LDAP_GROUPNAME=

# Registry settings — project name is your RCP project slug
DOCKER_REGISTRY=registry.rcp.epfl.ch
DOCKER_PROJECT=impresso
