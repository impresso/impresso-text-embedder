# Docker build + Run:AI submission settings for EPFL RCP.
# Copy to .env.docker and fill in. Never commit the filled version.

# Find your EPFL UID/GID by running `id` on haas001.rcp.epfl.ch.
# https://wiki.rcp.epfl.ch/en/home/CaaS/FAQ/how-to-find-uid-gid
LDAP_UID=
LDAP_GID=
LDAP_USERNAME=
LDAP_GROUPNAME=

# Harbor registry + project (your RCP project slug).
DOCKER_REGISTRY=registry.rcp.epfl.ch
DOCKER_PROJECT=impresso
DOCKER_IMAGE=impresso-text-embedder
# DOCKER_TAG defaults to the current git branch (slashes -> dashes).
# Uncomment to override, e.g. when pushing a stable snapshot.
# DOCKER_TAG=research-chunking-eval

# Run:AI project + PVC (where the HF cache and outputs live on /rcp-scratch).
RUNAI_PROJECT=dhlab-journe
RCP_PVC=dhlab-scratch
RCP_SCRATCH_PATH=/rcp-scratch
RUNAI_NODE_POOL=default

# Optional GPU product label (set via `runai submit --node-type`). The
# only way to pick H100 vs H200 within the h100 pool — pair with
# RUNAI_NODE_POOL=h100. Find labels with:
#   kubectl get nodes -L nvidia.com/gpu.product
# RUNAI_GPU_TYPE=NVIDIA-H100-80GB-HBM3
# RUNAI_GPU_TYPE=NVIDIA-H200-141GB

# Optional resource requests + limits. Set CPU so the 10-way S3 prefetch
# + encode + upload overlap isn't starved on busy nodes. Memory: bf16
# model + KV cache + per-batch tokenization.
# RUNAI_CPU=8
# RUNAI_CPU_LIMIT=16
# RUNAI_MEMORY=32G
# RUNAI_MEMORY_LIMIT=64G

# Model pin forwarded to `runai-submit` as `--model-name` + `--model-revision`.
# Defaults in the Makefile mirror the Python DEFAULT_MODEL_REVISION; uncomment
# to override here (e.g. bump the revision without touching code).
# CREATOR_NAME=Alibaba-NLP
# HF_MODEL_NAME=gte-multilingual-base
# HF_MODEL_VERSION=f7d567e
