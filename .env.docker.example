# Docker build + Run:AI submission settings for EPFL RCP.
# Copy to .env.docker and fill in. Never commit the filled version.

# Find your EPFL UID/GID by running `id` on haas001.rcp.epfl.ch.
# https://wiki.rcp.epfl.ch/en/home/CaaS/FAQ/how-to-find-uid-gid
LDAP_UID=
LDAP_GID=
LDAP_USERNAME=
LDAP_GROUPNAME=

# Harbor registry + project (your RCP project slug).
DOCKER_REGISTRY=registry.rcp.epfl.ch
DOCKER_PROJECT=impresso
DOCKER_IMAGE=impresso-text-embedder
DOCKER_TAG=v0.1

# Run:AI project + PVC (where the HF cache and outputs live on /rcp-scratch).
RUNAI_PROJECT=dhlab-journe
RCP_PVC=dhlab-scratch
RCP_SCRATCH_PATH=/rcp-scratch
RUNAI_NODE_POOL=default
